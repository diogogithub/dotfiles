[Unit]
Description=Encrypted Restic system backup
After=network-online.target
Wants=network-online.target
ConditionACPower=true
ConditionPathExists=/etc/dotfiles-private/restic.env

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/dotfiles-backup
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
Environment=RESTIC_CACHE_DIR=/var/cache/restic
CacheDirectory=restic
