#!/bin/dash
set -eu
action=${1:-}
case $action in up|down|toggle|mic-toggle) ;; *) printf 'Usage: %s up|down|toggle|mic-toggle\n' "$0" >&2; exit 2 ;; esac
if command -v wpctl >/dev/null 2>&1; then
    case $action in up) wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;; down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;; toggle) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;; mic-toggle) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;; esac
elif command -v pactl >/dev/null 2>&1; then
    case $action in up) pactl set-sink-volume @DEFAULT_SINK@ +5% ;; down) pactl set-sink-volume @DEFAULT_SINK@ -5% ;; toggle) pactl set-sink-mute @DEFAULT_SINK@ toggle ;; mic-toggle) pactl set-source-mute @DEFAULT_SOURCE@ toggle ;; esac
elif command -v amixer >/dev/null 2>&1; then
    case $action in up) amixer -q set Master 5%+ ;; down) amixer -q set Master 5%- ;; toggle) amixer -q set Master toggle ;; mic-toggle) amixer -q set Capture toggle ;; esac
else
    printf 'No wpctl, pactl, or amixer command found.\n' >&2
    exit 1
fi
