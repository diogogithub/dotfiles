#!/bin/dash
set -eu
case ${1:-} in up) change='+5%' ;; down) change='5%-' ;; *) printf 'Usage: %s up|down\n' "$0" >&2; exit 2 ;; esac
if command -v brightnessctl >/dev/null 2>&1; then exec brightnessctl set "$change"; fi
if command -v light >/dev/null 2>&1; then case $1 in up) exec light -A 5 ;; down) exec light -U 5 ;; esac; fi
printf 'No brightnessctl or light command found.\n' >&2
exit 1
