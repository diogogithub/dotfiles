# Portable i3 configuration for an XFCE-backed session.
set $mod Mod4
set $alt Mod1
set $term ~/.local/libexec/dotfiles/terminal
set $launcher ~/.local/libexec/dotfiles/launcher
set $files ~/.local/libexec/dotfiles/file-manager

font pango:PT Sans, Hack, FontAwesome, monospace 11
floating_modifier $mod
focus_follows_mouse no
workspace_layout stacking
popup_during_fullscreen smart
workspace_auto_back_and_forth yes
# Traditional edge-to-edge tiling, without gaps.
gaps inner 0
gaps outer 0

# Restore original i3 focused/unfocused greys (no bright borders).
set $numix_active #444444
set $numix_bg #444444
set $numix_dark #2f343f
set $numix_text #f3f4f5
set $numix_muted #a4a6a9
client.focused          $numix_active $numix_bg   $numix_text  $numix_active $numix_active
client.focused_inactive $numix_dark   $numix_dark $numix_muted $numix_dark   $numix_dark
client.unfocused        $numix_dark   $numix_dark $numix_muted $numix_dark   $numix_dark
client.urgent           #E53935       #E53935     $numix_text  #E53935       #E53935
client.placeholder      $numix_dark   $numix_dark $numix_muted $numix_dark   $numix_dark

set $ws1 "1 "
set $ws2 "2 "
set $ws3 "3 "
set $ws4 "4 "
set $ws5 "5 "
set $ws6 "6 "
set $ws7 "7 "
set $ws8 "8 "
set $ws9 "9 "
set $ws10 "10 "

bindsym $mod+Return exec --no-startup-id kitty
bindsym $mod+Shift+f exec --no-startup-id firefox
bindsym $mod+Shift+m exec --no-startup-id thunderbird
bindsym $mod+Shift+t exec --no-startup-id thunar
bindsym $mod+Shift+F5 exec --no-startup-id systemctl --user start --no-block dotfiles-spotlight.service
bindsym $mod+o exec --no-startup-id pavucontrol
bindsym $mod+z exec --no-startup-id $launcher
bindsym Mod1+F2 exec --no-startup-id $launcher
bindsym $mod+d exec --no-startup-id $launcher
bindsym $mod+Ctrl+e exec --no-startup-id $files
bindsym Print exec --no-startup-id ~/.local/libexec/dotfiles/screenshot
bindsym $mod+Shift+x exec --no-startup-id ~/.local/libexec/dotfiles/lock
bindsym Ctrl+Mod1+l exec --no-startup-id ~/.local/libexec/dotfiles/lock
set $mode_system "System: (l) lock, (e) logout, (s) suspend, (r) reboot, (Shift+s) shutdown"
mode $mode_system {
    bindsym l exec --no-startup-id ~/.local/libexec/dotfiles/system-action lock, mode "default"
    bindsym e exec --no-startup-id ~/.local/libexec/dotfiles/system-action logout, mode "default"
    bindsym s exec --no-startup-id ~/.local/libexec/dotfiles/system-action suspend, mode "default"
    bindsym r exec --no-startup-id ~/.local/libexec/dotfiles/system-action reboot, mode "default"
    bindsym Shift+s exec --no-startup-id ~/.local/libexec/dotfiles/system-action poweroff, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Pause mode $mode_system
bindsym $mod+Home mode $mode_system
bindsym $mod+Shift+p mode $mode_system
bindsym XF86Sleep exec --no-startup-id ~/.local/libexec/dotfiles/system-action suspend
bindsym Mod1+F4 kill
bindsym $mod+Ctrl+l exec --no-startup-id ~/.local/libexec/dotfiles/lock
bindsym $mod+Shift+q kill

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+b workspace back_and_forth
bindsym $mod+Shift+b move container to workspace back_and_forth; workspace back_and_forth
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev
bindsym $mod+Shift+s sticky toggle
bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+comma splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+space focus mode_toggle
bindsym $mod+c focus child
bindsym $mod+u border none
bindsym $mod+y border pixel 1
bindsym $mod+n border normal
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

mode "resize" {
    bindsym h resize shrink width 10 px or 5 ppt
    bindsym j resize grow height 10 px or 5 ppt
    bindsym k resize shrink height 10 px or 5 ppt
    bindsym l resize grow width 10 px or 5 ppt
    bindsym Left resize shrink width 10 px or 5 ppt
    bindsym Down resize grow height 10 px or 5 ppt
    bindsym Up resize shrink height 10 px or 5 ppt
    bindsym Right resize grow width 10 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/libexec/dotfiles/volume up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/libexec/dotfiles/volume down
bindsym XF86AudioMute exec --no-startup-id ~/.local/libexec/dotfiles/volume toggle
bindsym XF86AudioMicMute exec --no-startup-id ~/.local/libexec/dotfiles/volume mic-toggle
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/libexec/dotfiles/brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/libexec/dotfiles/brightness down
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

set $bar_background #2f343f
set $bar_focus #444444
set $bar_text #f3f4f5
set $bar_muted #676E7D
bar {
    position bottom
    mode dock
    status_command i3blocks -c ~/.config/i3/i3blocks.conf
    tray_output primary
    font pango:PT Sans, FontAwesome, monospace 11
    colors {
        background $bar_background
        separator #757575
        focused_workspace $bar_focus $bar_focus $numix_text
        inactive_workspace $bar_background $bar_background $bar_muted
        urgent_workspace #E53935 #E53935 $bar_text
    }
}

exec --no-startup-id ~/.local/libexec/dotfiles/i3-autostart

# Add monitor layout and host-only commands in this directory.
include ~/.config/i3/config.d/*.conf
